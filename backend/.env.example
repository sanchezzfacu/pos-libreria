# Copiá este archivo a ".env" y completá con tus valores reales.

# Connection string de MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/pos-libreria

PORT=4000

JWT_SECRET=cambiar-esto-por-un-secreto-largo-y-random

ADMIN_USERNAME=mama
ADMIN_PASSWORD=cambiar-esta-clave

FRONTEND_URL=http://localhost:3000

# --- Facturación electrónica AFIP (Factura C) ---
# PAUSADA por ahora mientras se termina de resolver un problema de
# certificados — el POS imprime un ticket simple sin facturar. Para
# retomarla más adelante, poné AFIP_ENABLED=true (con el resto de las
# variables de acá abajo ya completadas).
AFIP_ENABLED=false

# "true" = factura de verdad, con validez fiscal real, contra los
# servidores de producción de AFIP.
# "false" = ambiente de homologación (testing), no tiene validez fiscal.
# Usá "false" hasta haber probado que todo funciona bien.
AFIP_PRODUCTION=false

# CUIT del emisor (el mismo con el que generaste el certificado)
AFIP_CUIT=27254113455

# Punto de venta dado de alta en AFIP como "Facturación Electrónica"
AFIP_PTO_VTA=2

# Access token de https://app.afipsdk.com (uno solo sirve para
# homologación y producción, lo que cambia es AFIP_PRODUCTION)
AFIP_ACCESS_TOKEN=

# IMPORTANTE: el certificado de HOMOLOGACIÓN (testing, se genera en
# https://wsaahomo.afip.gov.ar) y el de PRODUCCIÓN (real, se genera en
# el portal normal de AFIP) son DOS TRÁMITES DISTINTOS y NO son
# intercambiables — un certificado de producción no funciona contra los
# servidores de homologación, y te va a tirar error 400 si los mezclás.
# Por eso van en variables separadas; el sistema elige el par correcto
# solo, según AFIP_PRODUCTION.
#
# Para pegar el contenido: se puede pegar el archivo completo con saltos
# de línea reales entre comillas, o todo en una sola línea reemplazando
# cada salto de línea por \n (dos caracteres) — el código lo convierte
# solo (ver normalizarPem en backend/src/services/afipService.js).
AFIP_CERT_HOMOLOGACION=
AFIP_KEY_HOMOLOGACION=

AFIP_CERT_PRODUCCION=
AFIP_KEY_PRODUCCION=
